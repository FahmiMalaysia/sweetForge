# ============================================================
# SweetForge API — environment variables
# Set these SAME names in Vercel → Project → Settings → Environment Variables
# ============================================================

# Neon Postgres connection string (https://neon.tech → Connection string)
DATABASE_URL=postgresql://neondb_owner:npg_1uoAbDq8vxKR@ep-quiet-snow-b3w5gjq4-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=af066b240d51fbd0c5a45ce13041760a4621787c703fe3d2f556af540ee3f6e4e0b3ba3f569fa091b591256eb21ecea3
JWT_EXPIRES_IN=7d

# CORS origin ("*" is fine: auth uses Bearer tokens, not cookies)
CORS_ORIGIN=*

# Storage quota per user, bytes (default 10MB) and max single upload (default 5MB)
USER_QUOTA_BYTES=10485760
MAX_UPLOAD_BYTES=5242880

# "true" = require login (no anonymous IP-based users)
DISABLE_ANONYMOUS=false
